# Credenciales del RustFS local (Homebrew, ZIP, Launcher o Docker).
RUSTFS_ACCESS_KEY=atempo
RUSTFS_SECRET_KEY=atempoatempo
RUSTFS_BUCKET=justifications

# API y consola (solo en 127.0.0.1).
RUSTFS_ADDRESS=127.0.0.1:9000
RUSTFS_CONSOLE_ADDRESS=127.0.0.1:9001

# Datos: por defecto rustfs/data/ (fuera de git). Solo si usas otra ruta:
# RUSTFS_DATA=/ruta/a/tus/datos
#
# Binario: con Homebrew no hace falta (está en el PATH). Con ZIP:
# RUSTFS_BIN=$HOME/rustfs/bin/rustfs
# Windows (PowerShell), ejemplo:
# RUSTFS_BIN=C:\rustfs\bin\rustfs.exe

RUSTFS_ENDPOINT=http://127.0.0.1:9000
