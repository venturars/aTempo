    "eslint-config-prettier": "10.1.8",
    "globals": "16.4.0",
    "jest": "30.2.0",
    "prettier": "3.9.10",
    "ts-jest": "29.4.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4"
