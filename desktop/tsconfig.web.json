{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    "src/preload/*.d.ts",
    "../web/src/admin/**/*",
    "../web/src/shared/ThemeToggle.tsx"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@renderer/*": [
        "src/renderer/src/*"
      ],
      "@web/admin/*": [
        "../web/src/admin/*"
      ],
      "react": [
        "node_modules/@types/react"
      ],
      "react/*": [
        "node_modules/@types/react/*"
      ],
      "zustand": [
        "node_modules/zustand"
      ],
      "@tanstack/react-router": [
        "node_modules/@tanstack/react-router"
      ],
      "@web/*": [
        "../web/src/*"
      ]
    }
  },
  "exclude": [
    "../web/src/admin/AdminLayout.tsx",
    "../web/src/admin/AdminEntry.tsx"
  ]
}
